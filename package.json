{
	"version": "1.0.0",
	"name": "boards-room",
	"description": "A collaborative whiteboard application with real-time features.",
	"repository": "https://github.com/Excali-Boards/boards-room",
	"author": "Digital39999",
	"type": "module",
	"scripts": {
		"ts": "pnpm install typescript --save-dev -g",
		"init": "pnpm install && pnpm run build && pnpm run start",
		"start": "node --no-deprecation dist/index.js",
		"build": "tsc",
		"watch": "tsc --watch",
		"typecheck": "tsc --noEmit",
		"rebuild": "pnpm run build && pnpm run migrate && pnpm run start",
		"lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
		"afterbuild": "pnpm run migrate && pnpm run start",
		"postinstall": "pnpm prisma generate",
		"db:create": "node dist/scripts/db.js",
		"migrate": "pnpm db:create && pnpm prisma db push",
		"updates": "pnpm npm-check-updates -i --format group"
	},
	"main": "dist/index.js",
	"license": "GPL-3.0",
	"dependencies": {
		"@aws-sdk/client-s3": "3.893.0",
		"@aws-sdk/s3-request-presigner": "^3.940.0",
		"@excalidraw/excalidraw": "0.18.1",
		"@hono/node-server": "1.19.19",
		"@msgpack/msgpack": "3.1.3",
		"@prisma/client": "6.16.3",
		"@tldraw/sync": "4.1.1",
		"@types/pako": "2.0.4",
		"axios": "1.12.2",
		"dotenv": "16.4.7",
		"hono": "4.9.12",
		"iovalkey": "^0.3.3",
		"pako": "2.1.0",
		"pg": "8.16.3",
		"pidusage": "4.0.1",
		"prom-client": "15.1.3",
		"socket.io": "4.8.4",
		"socket.io-msgpack-parser": "3.0.2",
		"unfurl.js": "6.4.0",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.33",
		"zod": "4.1.13"
	},
	"devDependencies": {
		"@types/pg": "8.15.6",
		"@types/pidusage": "2.0.5",
		"@typescript-eslint/eslint-plugin": "8.44.1",
		"@typescript-eslint/parser": "8.44.1",
		"eslint": "8.57.1",
		"prisma": "6.16.3",
		"typescript": "5.7.3",
		"typescript-eslint": "8.44.1"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
